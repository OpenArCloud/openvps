# Copy this file to docker.env in the repository root and edit for your host.
#
# Start stack:
#   docker compose --env-file docker.env build
#   docker compose --env-file docker.env up -d
#
# Public URLs (MAP*_URL) are for FusionAuth redirects and client apps — not injected
# into mapregistry/mapselector/maplocalizer by compose. In-cluster URLs are set in
# docker-compose.yaml (e.g. MAPLOCALIZER_URL=http://maplocalizer:8000 on the backend).

# --- Optional HTTP(S) proxy for image builds (leave empty if not needed) ---
MY_HTTP_PROXY=
MY_HTTPS_PROXY=

# --- Host user/group for map files on the shared volume (Linux: run `id -u` / `id -g`) ---
MY_USER_ID=1000
MY_GROUP_ID=1000

# --- Shared uploads volume (maps, status.json, coverage index) ---
MY_SHARED_MAPS_DIR=${HOME}/data/maps

# --- FusionAuth (see docs/FusionAuth.md) ---
AUTH_FUSIONAUTH_ID=
AUTH_FUSIONAUTH_SECRET=
AUTH_FUSIONAUTH_ISSUER=https://your.domain.name:8045
AUTH_SECRET=

# --- MapBuilder frontend (container nginx listens on 80/443; host binds below) ---
# Direct: MAPBUILDER_PORT=8047 and MAPBUILDER_PORT_HTTPS=8443
# Nginx on host: use e.g. MAPBUILDER_PORT=18047, MAPBUILDER_PORT_HTTPS=18443
MAPBUILDER_PORT=8047
MAPBUILDER_PORT_HTTPS=8443
MAPBUILDER_URL=https://your.domain.name:8047

# --- MapAligner ---
MAPALIGNER_PORT=8048
MAPALIGNER_URL=https://your.domain.name:8048

# --- MapLocalizer (GPU; optional host bind for /load_map, debugging — not public GeoPose) ---
MAPLOCALIZER_PORT=8043

# --- MapRegistry (coverage index; optional host bind for GET /maps, GET /maps/query) ---
MAPREGISTRY_PORT=8044

# --- MapSelector (public GeoPose entry for AR clients) ---
# Container listens on 8102. Host publish = MAPSELECTOR_PORT → container:8102.
# Direct test: MAPSELECTOR_PORT=8046  →  curl http://127.0.0.1:8046/health
# Host nginx on public :8046: use MAPSELECTOR_PORT=18046 and proxy to 127.0.0.1:18046
MAPSELECTOR_PORT=8046
MAPSELECTOR_URL=https://your.domain.name:8046
# First localize after auto map load can exceed 120s; proxy timeout (seconds, default 300)
MAPSELECTOR_LOCALIZE_TIMEOUT_S=600

# --- Example: host nginx in front (internal binds 1804x, public 804x) ---
# MAPBUILDER_PORT=18047
# MAPBUILDER_PORT_HTTPS=18443
# MAPALIGNER_PORT=18048
# MAPLOCALIZER_PORT=18043
# MAPREGISTRY_PORT=18044
# MAPSELECTOR_PORT=18046
# MAPBUILDER_URL=https://openvps.org:8047
# MAPALIGNER_URL=https://openvps.org:8048
# MAPSELECTOR_URL=https://openvps.org:8046