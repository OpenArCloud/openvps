# Paths (required)
uploadsDir=/home/johndoe/uploads
scriptsDir=/home/johndoe/scripts
hlocDir=/home/johndoe/Hierarchical-Localization
shell=bash
# settingsDir=/home/johndoe/uploads/settings

# FusionAuth / Auth.js (required for protected routes)
AUTH_FUSIONAUTH_ID=
AUTH_FUSIONAUTH_SECRET=
AUTH_FUSIONAUTH_ISSUER=
AUTH_SECRET=

# MapLocalizer — in-cluster only (load map / current_map_id). Not the public GeoPose URL.
# Local backend against root docker-compose host binds:
MAPLOCALIZER_URL=http://localhost:8043
# In compose, the backend service uses http://maplocalizer:8000 (do not set public HTTPS here).

# MapRegistry — optional; when set, coverage stage notifies POST /internal/reload after coverage.json is written.
MAPREGISTRY_URL=http://localhost:8044